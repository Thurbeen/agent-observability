    {
      "type": "timeseries",
      "title": "Mean Gateway reconcile duration",
      "description": "Mean reconcile of a Conversation or a Listener.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "2m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (fleet_controller) (rate(fleet_reconcile_duration_seconds_sum{job=~\"$job\",fleet_controller=~\"ConversationController|ListenerController\"}[$__rate_interval])) / sum by (fleet_controller) (rate(fleet_reconcile_duration_seconds_count{job=~\"$job\",fleet_controller=~\"ConversationController|ListenerController\"}[$__rate_interval]))",
          "legendFormat": "{{fleet_controller}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
