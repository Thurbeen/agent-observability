{
  "uid": "fleet-gateway",
  "title": "Fleet Gateway and inbox",
  "description": "Inbox depth, deliveries and the Gateway controllers.",
  "tags": [
    "fleet"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "job",
        "label": "Fleet",
        "description": "The Prometheus job of a Fleet manager: service.namespace/service.name, or the scrape job.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(fleet_reconcile_duration_seconds_count, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(fleet_reconcile_duration_seconds_count, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "",
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "fleet"
      ],
      "title": "Fleet",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Inbox",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Inbox entries waiting",
      "description": "Undelivered inbox entries over every Task, at the start of the latest pass. Fleet delivers an entry when the Task's session is idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "2m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "max(fleet_inbox_depth{job=~\"$job\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Delivered",
      "description": "Inbox entries delivered over the range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "2m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum ((((fleet_effects_total{job=~\"$job\",fleet_effect=\"deliver\",fleet_outcome=~\"delivered|already\"}) * 1) unless (fleet_effects_total{job=~\"$job\",fleet_effect=\"deliver\",fleet_outcome=~\"delivered|already\"} offset $__range)) or increase(fleet_effects_total{job=~\"$job\",fleet_effect=\"deliver\",fleet_outcome=~\"delivered|already\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Delivery failed or unknown",
      "description": "Deliveries that failed, or whose outcome Fleet could not observe.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "2m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum ((((fleet_effects_total{job=~\"$job\",fleet_effect=\"deliver\",fleet_outcome=~\"failed|unknown\"}) * 1) unless (fleet_effects_total{job=~\"$job\",fleet_effect=\"deliver\",fleet_outcome=~\"failed|unknown\"} offset $__range)) or increase(fleet_effects_total{job=~\"$job\",fleet_effect=\"deliver\",fleet_outcome=~\"failed|unknown\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "text",
      "title": "Per-Task depth",
      "options": {
        "mode": "markdown",
        "content": "Fleet v2.4 exports the inbox depth as one total without a Task attribute. Find the Task in the **Fleet traces** dashboard (`effect deliver` spans)."
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Inbox depth",
      "description": "Undelivered inbox entries over time. A depth that never returns to zero means a Task's session never goes idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "2m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "max(fleet_inbox_depth{job=~\"$job\"})",
          "legendFormat": "waiting"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(^|.* )error( .*|$)"
            },
            "properties": [
              {
                "id": "color",
