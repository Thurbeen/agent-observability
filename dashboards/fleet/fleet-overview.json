{
  "uid": "fleet-overview",
  "title": "Fleet overview",
  "description": "Fleet v2 manager health: reconcile passes, effects and errors.",
  "tags": [
    "agent-observability",
    "fleet"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "job",
        "label": "Fleet",
        "description": "The Prometheus job of a Fleet manager: service.namespace/service.name, or the scrape job.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(fleet_reconcile_duration_seconds_count, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(fleet_reconcile_duration_seconds_count, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "",
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "agent-observability"
      ],
      "title": "Agents",
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Reconciles per second",
      "description": "Object reconciles per second over all controllers. Zero means the manager stopped sweeping.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "2m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum (rate(fleet_reconcile_duration_seconds_count{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
