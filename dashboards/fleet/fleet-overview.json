        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum ((((fleet_reconcile_duration_seconds_count{job=~\"$job\",fleet_outcome=~\"error|leaseLost\"}) * 1) unless (fleet_reconcile_duration_seconds_count{job=~\"$job\",fleet_outcome=~\"error|leaseLost\"} offset $__range)) or increase(fleet_reconcile_duration_seconds_count{job=~\"$job\",fleet_outcome=~\"error|leaseLost\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
