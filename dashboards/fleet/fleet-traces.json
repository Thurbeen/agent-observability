{
  "uid": "fleet-traces",
  "title": "Fleet traces",
  "description": "Reconcile, effect and forge spans in Tempo.",
  "tags": [
    "agent-observability",
    "fleet"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "name": "tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "hide": 0,
        "current": {},
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "service",
        "label": "Service",
        "description": "The service.name Fleet exports under (OTEL_SERVICE_NAME).",
        "type": "textbox",
        "query": "fleet",
        "current": {
          "text": "fleet",
          "value": "fleet"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "object",
        "label": "Object",
        "description": "A regular expression on the Fleet object name (fleet.name).",
        "type": "textbox",
        "query": ".+",
        "current": {
          "text": ".+",
          "value": ".+"
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "agent-observability"
      ],
      "title": "Agents",
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Latency from spans",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Object reconcile p50 / p95 by controller",
      "description": "Quantiles of one object's reconcile, from spans. Needs TraceQL metrics in Tempo.",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" && name =~ \"reconcile .+\" && name != \"reconcile pass\" } | quantile_over_time(duration, .5, .95) by (span.fleet.controller)",
          "metricsQueryType": "range",
          "step": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Reconcile pass p50 / p95",
      "description": "Quantiles of one whole pass over every kind.",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" && name = \"reconcile pass\" } | quantile_over_time(duration, .5, .95)",
          "metricsQueryType": "range",
          "step": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Find a trace",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Object reconciles",
      "description": "One reconcile of a Fleet object. Set Object to a Task or ChangeRequest name.",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" && name =~ \"reconcile .+\" && name != \"reconcile pass\" && span.fleet.name =~ \"$object\" }",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Effects",
      "description": "spawn, brief, deliver, release and markReady effects, with their outcome.",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" && name =~ \"effect .+\" && span.fleet.name =~ \"$object\" }",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Errors",
      "description": "Commands with a non-zero exit and reconciles that failed.",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" && status = error }",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Forge polls without an answer",
      "description": "Change polls that were throttled, timed out or failed, with their forge host.",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" && name = \"forge poll\" && span.fleet.outcome !~ \"known|absent\" && span.fleet.name =~ \"$object\" }",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Commands",
      "description": "Fleet CLI commands, such as a worker's fleet result, when its session exports telemetry.",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" && name =~ \"fleet .+\" }",
          "limit": 20,
          "spss": 3,
          "tableType": "spans"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 9
      }
    }
  ]
}
