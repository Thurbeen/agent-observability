{
  "uid": "thurbox-events",
  "title": "Thurbox session events",
  "description": "Thurbox's session event log records and diagnostic logs in Loki.",
  "tags": [
    "agent-observability",
    "thurbox"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {},
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "session",
        "label": "Session",
        "description": "A regular expression on the session name.",
        "type": "textbox",
        "query": ".+",
        "current": {
          "text": ".+",
          "value": ".+"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "agent",
        "label": "Agent",
        "description": "A regular expression on the agent.",
        "type": "textbox",
        "query": ".+",
        "current": {
          "text": ".+",
          "value": ".+"
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "agent-observability"
      ],
      "title": "Agents",
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Session events",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Session events",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "interval": "10m",
      "description": "Session events per 10 minutes, from Thurbox's event log records.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "legendFormat": "{{event}}",
          "expr": "sum by (event) (count_over_time({service_name=\"thurbox\"} |= \"thurbox.session.\" | thurbox_session_name =~ \"$session\" | agent =~ \"$agent\" | label_format event=\"{{__line__}}\" [$__interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 7
      }
    },
    {
      "type": "logs",
      "title": "Session timeline",
      "description": "One line per session event: created, state_changed (from -> to), changed and gone (reason). Each record carries thurbox.session.id, which the agents' own telemetry carries too.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=\"thurbox\"} |= \"thurbox.session.\" | thurbox_session_name =~ \"$session\" | agent =~ \"$agent\" | line_format \"{{.thurbox_session_name}}  {{.agent}}  {{trimPrefix \\\"thurbox.session.\\\" __line__}} {{.from}}{{if .to}} -> {{.to}}{{end}} {{.reason}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 12
      }
    },
    {
      "type": "row",
      "title": "Diagnostics",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "logs",
      "title": "Interface warnings",
      "description": "The interface's own WARN and ERROR log lines, sent when export_diagnostic_logs is on.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=\"thurbox\"} != \"thurbox.session.\" | detected_level=~\"warn|error\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 7
      }
    }
  ]
}
