            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum ((((fleet_forge_calls_total{job=~\"$job\",fleet_forge_host=~\"$host\",fleet_outcome=~\"notLoggedIn|refused\"}) * 1) unless (fleet_forge_calls_total{job=~\"$job\",fleet_forge_host=~\"$host\",fleet_outcome=~\"notLoggedIn|refused\"} offset $__range)) or increase(fleet_forge_calls_total{job=~\"$job\",fleet_forge_host=~\"$host\",fleet_outcome=~\"notLoggedIn|refused\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
